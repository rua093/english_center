<?php
declare(strict_types=1);

/*
|--------------------------------------------------------------------------
| Local / Shared-hosting overrides
|--------------------------------------------------------------------------
| Copy this file to `local.php` and update the values for each environment.
| The real `local.php` is ignored by git.
| `BASE_PATH` and `APP_NAME` are available before this file is loaded.
| Other config values below will be loaded first here, then any missing
| defaults will be filled by `config/app.php` and the other config files.
*/

define('APP_ENV', 'production');
define('APP_BASE_URL', 'https://your-domain.com');

define('DB_HOST', 'localhost');
define('DB_PORT', '3306');
define('DB_NAME', 'your_database_name');
define('DB_USER', 'your_database_user');
define('DB_PASS', 'your_database_password');

define('APP_SECRET', 'replace-with-a-long-random-secret');

/*
| Shared hosting note:
| If your public web root points directly to `public_html/`, keep these values.
| If not, adjust them to the real writable/public paths provided by the host.
*/
define('FILE_STORAGE_DRIVER', 'local');
define('UPLOAD_STORAGE_PATH', BASE_PATH . '/assets/uploads');
define('UPLOAD_PUBLIC_BASE_PATH', '/assets/uploads');

/*
| Optional S3-compatible object storage
| Set FILE_STORAGE_DRIVER to 's3' to store new uploads in your bucket.
| Existing local file URLs will continue to work.
*/
define('S3_ENDPOINT', 'https://s3-hcm-r2.s3cloud.vn');
define('S3_REGION', 'auto');
define('S3_BUCKET', '');
define('S3_ACCESS_KEY', '');
define('S3_SECRET_KEY', '');
define('S3_PUBLIC_BASE_URL', '');
define('S3_USE_PATH_STYLE', true);
define('S3_OBJECT_ACL', '');

/*
| Optional mail settings
*/
define('MAIL_ENABLED', false);
define('MAIL_TRANSPORT', 'smtp');
define('MAIL_HOST', '');
